[Unit]
Description=LLQA CRM 24/7 runner
After=network-online.target
Wants=network-online.target

[Service]
User=llqa
WorkingDirectory=/opt/llqa-runner
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/llqa-runner/browsers
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/llqa-runner/runner.js
Restart=always
RestartSec=10
MemoryMax=1500M

[Install]
WantedBy=multi-user.target
